<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>KIZentrale</RootNamespace>
    <AssemblyName>KI-Zentrale</AssemblyName>
    <ApplicationIcon>kiz.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Description>Desktop-Widget für lokale KI-Tools mit Systemmonitor</Description>
    <!-- Eine einzelne .exe inklusive .NET-Laufzeit (läuft ohne installiertes .NET) -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="widget.html" LogicalName="widget.html" />
    <EmbeddedResource Include="monitor.html" LogicalName="monitor.html" />
    <EmbeddedResource Include="kiz.ico" LogicalName="kiz.ico" />
    <Compile Remove="tools\**" />
  </ItemGroup>

</Project>
