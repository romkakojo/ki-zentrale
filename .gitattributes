# Zeilenenden normalisieren; Windows-Skripte behalten CRLF
* text=auto
*.cs      text eol=crlf
*.csproj  text eol=crlf
*.sln     text eol=crlf
*.props   text eol=crlf
*.ps1     text eol=crlf
*.html    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.manifest text eol=crlf

